{
  "name": "estamparia-manager",
  "version": "1.0.0",
  "description": "Sistema de Gestão de Pedidos de Estamparia e Pastas de Clientes",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "pack": "vite build && electron-builder --dir",
    "start": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.4.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.orderseparator.app",
    "productName": "Order Separator",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "corel-plugin/**/*"
    ],
    "extraResources": [
      {
        "from": "corel-plugin",
        "to": "corel-plugin"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "sign": null,
      "signAndEditExecutable": false
    }
  }
}
